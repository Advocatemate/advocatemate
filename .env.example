# Copy to .env for LOCAL development only. Never commit a real .env.
# Staging/production values come from the hosting platform's secret manager.

ENVIRONMENT=development            # development | test | staging | production
LOG_LEVEL=INFO

# --- database / cache (docker-compose service names) ---
POSTGRES_USER=advocatemate
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=advocatemate
DATABASE_URL=postgresql+psycopg://advocatemate:change-me-local-only@db:5432/advocatemate
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/var/lib/advocatemate

# --- auth: generate with  python -c "import secrets;print(secrets.token_urlsafe(48))" ---
JWT_SECRET=
OTP_HASH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Google sign-in: Web OAuth client ID(s) that Google ID tokens must be issued for (comma-separated).
GOOGLE_CLIENT_IDS=
GOOGLE_LINK_TOKEN_MINUTES=10

# Admin portal (/admin). Sign-in uses the Web client above unless ADMIN_GOOGLE_CLIENT_ID is set; add the
# portal address to that client's Authorized JavaScript origins. ADMIN_ALLOWED_IPS: optional IPs/CIDRs.
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_MAX_HOURS=8
ADMIN_REAUTH_MINUTES=10
ADMIN_ALLOWED_IPS=

# Retired mobile-OTP login (kept only so old configuration still loads)
OTP_PROVIDER=disabled

# Comma-separated browser origins (mobile apps do not need CORS)
CORS_ORIGINS=

# --- upstream APHC sources ---
UPSTREAM_ENABLED=true
APHC_BASE_URL=https://aphc.gov.in
APHC_MIN_INTERVAL_SECONDS=1.5
LIVE_BOARD_POLL_SECONDS=60
LIVE_BOARD_STALE_SECONDS=180

# --- monitoring / push (optional) ---
SENTRY_DSN=
FCM_ENABLED=false
FCM_CREDENTIALS_FILE=
